# Exact tag plus multi-arch digest; Dependabot proposes updates.
FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# WeasyPrint system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    libcairo2 \
    libharfbuzz-subset0 \
    fonts-liberation \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-dev.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements-dev.lock

COPY pyproject.toml .
COPY src/ src/
COPY tests/ tests/
# docs/ is needed because tests/unit/test_slideshow.py reads docs/slideshow.html. Without it
# those tests error on FileNotFound inside the image while passing on the host - the same
# split that makes a test look green everywhere except the one place that gates a merge.
COPY docs/ docs/
# .github/ is needed for the same reason by tests/unit/test_workflow_keepalive.py, which
# reads .github/workflows/generate.yml.
COPY .github/ .github/
# tests/unit/test_dependency_pinning.py reads the lockfiles and Dockerfiles.
COPY requirements.lock Dockerfile Dockerfile.test ./

RUN pip install --no-cache-dir --no-deps --no-build-isolation .

ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-v"]
