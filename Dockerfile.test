FROM python:3.12-slim

# WeasyPrint system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    libcairo2 \
    fonts-liberation \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml .
COPY src/ src/
COPY tests/ tests/
# docs/ is needed because tests/unit/test_slideshow.py reads docs/slideshow.html. Without it
# those tests error on FileNotFound inside the image while passing on the host - the same
# split that makes a test look green everywhere except the one place that gates a merge.
COPY docs/ docs/
# .github/ is needed for the same reason by tests/unit/test_workflow_keepalive.py, which
# reads .github/workflows/generate.yml.
COPY .github/ .github/

RUN pip install --no-cache-dir ".[test]"

ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-v"]
